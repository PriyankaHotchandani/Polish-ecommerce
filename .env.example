# Supabase Configuration
# For local development, run `npx supabase start` to get these values
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_ACCESS_TOKEN=your_supabase_access_token
# Optional: if omitted, sync uses a free no-key translation fallback provider.
DEEPL_API_KEY=your_deepl_api_key
DEEPL_API_URL=https://api-free.deepl.com/v2/translate

# Hosted Supabase project reference
# Project ID: mdwbxwsrbqxyefbuwstr
# Project URL: https://mdwbxwsrbqxyefbuwstr.supabase.co

# Hero videos are hosted outside the app (too large for the Workers asset limit).
# Point this at the public base URL of the R2 bucket / CDN that serves
# tools.mp4 and household.mp4. Leave unset locally to use files in /public.
NEXT_PUBLIC_MEDIA_BASE_URL=https://your-r2-bucket.example.com

# Inventory sync
INVENTORY_SYNC_SECRET=replace_with_long_random_secret
CRON_SECRET=replace_with_same_value_as_inventory_sync_secret
SUPPLIER_STOCK_FEED_URL=https://vpn.gwalento.ovh/stany.txt
SUPPLIER_INFO_FEED_URL=https://vpn.gwalento.ovh/b2b/info.txt
SUPPLIER_NOKAUT_FEED_URL=https://sklep757254.shoparena.pl/console/integration/execute/name/Nokaut
