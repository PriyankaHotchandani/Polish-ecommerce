{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "polish-ecommerce",
  // Custom entrypoint that re-exports the generated OpenNext worker and adds the
  // `scheduled` handler used by the Cron Triggers below. See worker/index.mjs.
  "main": "worker/index.mjs",
  "compatibility_date": "2025-09-07",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Plain (non-secret) runtime variables. IMPORTANT: `wrangler deploy` treats this
  // block as authoritative for plain vars and resets them to match it on every
  // deploy -- a plain variable added only through the dashboard, with nothing
  // declared here, gets wiped the next time a deploy runs. That's what kept
  // erasing NEXT_PUBLIC_SUPABASE_URL after every merge. Secrets (SUPABASE_SERVICE_
  // ROLE_KEY, INVENTORY_SYNC_SECRET, CRON_SECRET, RESEND_API_KEY, ...) are a
  // separate Cloudflare mechanism that deploys don't touch, so they stay in the
  // dashboard's Variables and Secrets screen -- never put a secret in this file,
  // it's committed to the repo in plain text.
  //
  // NEXT_PUBLIC_SUPABASE_URL is safe to commit: it's a project hostname, not a
  // credential -- the same value already sits in this repo's README and
  // .env.example, and Next.js ships it to every browser regardless.
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://mdwbxwsrbqxyefbuwstr.supabase.co"
  },
  "observability": {
    // Keeps cron run logs (console.log/error from worker/index.mjs) in the
    // dashboard, so a failing sync is visible without `wrangler tail` attached.
    "enabled": true
  },
  "triggers": {
    "crons": [
      // Quantity/price refresh. Every minute is the shortest interval Cloudflare
      // Cron Triggers allow and is free; raise to "*/5 * * * *" if the supplier
      // feeds rate-limit. Overlapping runs are skipped by the `supplier_sync_locks`
      // row lock, so a slow run cannot pile up.
      "* * * * *",
      // Full catalogue re-import (products, categories, translations). Heavy, so
      // once a day. Must match FULL_SYNC_CRONS in worker/index.mjs.
      "15 2 * * *"
    ]
  }
}
